# Supabase Central Registry Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=sbp_your-access-token

# Authentication & Encryption
JWT_SECRET=your-jwt-secret-at-least-32-chars
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Server & Network Configuration
PORT=3000
APP_URL=http://localhost:3000
ROOT_DOMAIN=amertarva.com

# Allowed CORS Origins (separated by comma)
CORS_ORIGIN=https://amertarva.com,https://www.amertarva.com,https://learning-amertarva.vercel.app,http://localhost:4321,http://localhost:5173,http://localhost:4000

# OpenRouter AI Chatbot API Key
OPENROUTER_API_KEY=sk-or-v1-your-key-here