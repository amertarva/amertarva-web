# Backend API URL
# Dev   : Biarkan kosong — Vite proxy akan forward /api/* ke localhost:3000 otomatis
# Prod  : Isi dengan URL backend produksi, contoh:
# PUBLIC_BACKEND_URL=https://backend-amertarva.vercel.app
PUBLIC_BACKEND_URL=

# Main Portal Web App URL (Microservice)
PUBLIC_MAIN_WEB_URL=http://localhost:4000

# E-Learning Platform Self URL (Microservice)
PUBLIC_ELEARNING_URL=http://localhost:4321

# WhatsApp Contact Number
PUBLIC_WHATSAPP_PHONE=6280000000000
